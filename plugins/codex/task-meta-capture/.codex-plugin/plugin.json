{
  "version": "0.2.4",
  "name": "task-meta-capture",
  "description": "Metadata-only lifecycle capture for task-meta: tool outcome, git heads, session boundaries; no content.",
  "author": {
    "name": "kaicreator-mm"
  },
  "license": "MIT",
  "keywords": ["task-meta", "telemetry"],
  "hooks": {
    "hooks": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node -e \"try{require((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT)+'/scripts/run.cjs')}catch(e){}\"",
              "async": false,
              "timeout": 5
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node -e \"try{require((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT)+'/scripts/run.cjs')}catch(e){}\"",
              "async": true,
              "timeout": 5
            }
          ]
        }
      ],
      "PreToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node -e \"try{require((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT)+'/scripts/run.cjs')}catch(e){}\"",
              "async": true,
              "timeout": 5
            }
          ]
        }
      ],
      "PostToolUse": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node -e \"try{require((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT)+'/scripts/run.cjs')}catch(e){}\"",
              "async": true,
              "timeout": 5
            }
          ]
        }
      ],
      "Interrupt": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node -e \"try{require((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT)+'/scripts/run.cjs')}catch(e){}\"",
              "async": true,
              "timeout": 5
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node -e \"try{require((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT)+'/scripts/run.cjs')}catch(e){}\"",
              "async": false,
              "timeout": 5
            }
          ]
        }
      ],
      "SessionEnd": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "node -e \"try{require((process.env.CLAUDE_PLUGIN_ROOT||process.env.PLUGIN_ROOT)+'/scripts/run.cjs')}catch(e){}\"",
              "async": false,
              "timeout": 5
            }
          ]
        }
      ]
    }
  },
  "interface": {
    "displayName": "task-meta capture",
    "shortDescription": "Metadata-only task execution capture",
    "developerName": "kaicreator-mm",
    "category": "Developer Tools"
  }
}
